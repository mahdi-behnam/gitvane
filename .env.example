APP_NAME=RepoLens
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

DATABASE_URL=postgresql+asyncpg://repolens:repolens@postgres:5432/repolens
SYNC_DATABASE_URL=postgresql+psycopg://repolens:repolens@postgres:5432/repolens

REDIS_URL=redis://redis:6379/0

REPOLENS_WORKSPACE=/workspace/repos
MAX_INDEX_FILE_SIZE_KB=512
MAX_COMMITS_TO_MINE=500
MAX_EVAL_COMMITS=100

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
LOCAL_EMBEDDING_REVISION=516f4baf13dec4ddddda8631e019b5737c8bc250
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
USE_CUDA_IF_AVAILABLE=true

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedcode-7b-v1

ENABLE_LLM_EXPLANATIONS=true
LLM_TIMEOUT_SECONDS=30

IMPACT_DEPENDENCY_WEIGHT=0.35
IMPACT_SEMANTIC_WEIGHT=0.25
IMPACT_COCHANGE_WEIGHT=0.20
IMPACT_TEST_WEIGHT=0.10
IMPACT_RISK_WEIGHT=0.10

# Authentication & Cryptography Secrets
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90
ENCRYPTION_KEY=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth2/callback/google
